{
  "expo": {
    "name": "Rapid Nursing Review",
    "slug": "rapid-nursing-review",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f8f5",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.alexkorir.rapidnursingreview",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alexkorir.rapidnursingreview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#2f3337"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2f3337"
        }
      ],
      "expo-dev-client",
      [
        "expo-calendar",
        {
          "calendarPermission": "Rapid Nursing Review adds your study sessions to your calendar when you ask it to.",
          "remindersPermission": "Rapid Nursing Review does not use your reminders."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ea580c"
        }
      ]
    ],
    "extra": {
      "revenueCatAppleKey": "appl_dqAdVaIDuMHXlNAGZCgUdAfFXXY",
      "revenueCatGoogleKey": "goog_REPLACE_ME",
      "revenueCatTestKey": "test_REPLACE_ME",
      "useTestStore": false,
      "entitlementId": "pro",
      "privacyPolicyUrl": "https://github.com/kenyanfreshy/rapid-nursing-review-public/blob/main/PRIVACY.md",
      "termsUrl": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/",
      "supportEmail": "alexkorirbooks@gmail.com",
      "eas": {
        "projectId": "ffa76c48-2211-4a0f-b275-c9631d8cc0b7"
      }
    },
    "owner": "ronnykip"
  }
}
