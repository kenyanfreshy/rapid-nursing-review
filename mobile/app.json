{
  "expo": {
    "name": "Rapid Nursing Review",
    "slug": "rapid-nursing-review",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f8f5",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.alexkorir.rapidnursingreview",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alexkorir.rapidnursingreview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#2f3337"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2f3337"
        }
      ],
      "expo-dev-client"
    ],
    "extra": {
      "revenueCatAppleKey": "appl_REPLACE_ME",
      "revenueCatGoogleKey": "goog_REPLACE_ME",
      "revenueCatTestKey": "test_REPLACE_ME",
      "useTestStore": false,
      "entitlementId": "pro",
      "privacyPolicyUrl": "https://github.com/kenyanfreshy/rapid-nursing-review/blob/main/docs/PRIVACY.md",
      "termsUrl": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/",
      "supportEmail": "ak82korir@gmail.com"
    }
  }
}
